{
  "name": "@mapconductor/react-for-maptiler",
  "version": "0.2.1",
  "description": "MapTiler provider for MapConductor React SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.mjs",
      "require": "./dist/state.js"
    }
  },
  "files": [
    "dist",
    "README.ja.md",
    "README.es-419.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/state.ts --format cjs,esm --dts && npm run postbuild",
    "postbuild": "node -e \"require('fs').copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl.css'), './dist/style.css')\"",
    "dev": "tsup src/index.ts src/state.ts --format cjs,esm --watch",
    "clean": "rm -rf dist",
    "test": "echo 'No tests yet'"
  },
  "keywords": [
    "maps",
    "maptiler",
    "maplibre-gl",
    "react",
    "typescript"
  ],
  "author": "MapConductor",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mapconductor/js-sdk-core": "^0.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@mapconductor/js-sdk-core": "^0.2.0",
    "@mapconductor/js-sdk-react": "^0.2.1",
    "maplibre-gl": "^6.12.0"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
